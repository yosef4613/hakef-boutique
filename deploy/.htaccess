# הכיף שבאפיה: נוצר אוטומטית על ידי build/build.py
# האתר עצמו הוא קבצים סטטיים. וורדפרס נשאר רק לממשק הניהול ולעמודי המתכונים.
Options -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
RewriteEngine On
RewriteBase /
# HTTPS ובלי www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://hakef.com/$1 [R=301,L]
# אבטחה: חסימת xmlrpc
RewriteRule ^xmlrpc\.php$ - [F,L]
# כתובות ישנות
RewriteRule ^product-category/(כללי|שוקולד|קרמים-ומליות|קישוטים-אכילים)/?.*$ /shop/ [R=301,L,NE]
RewriteRule ^product-category/עוגות/(עוגות-בהזמנה|עוגות-מוס)/?$ /product-category/%D7%A2%D7%95%D7%92%D7%95%D7%AA/ [R=301,L,NE]
RewriteRule ^product-category/פטיפורים/(קינוחים-אישיים|פאים-אישיים)/?$ /product-category/%D7%A4%D7%98%D7%99%D7%A4%D7%95%D7%A8%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^product-tag/.*$ /shop/ [R=301,L,NE]
RewriteRule ^recipes/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^שוקלד-קרנץ/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^(מדיניות-החזרים|cart|checkout|my-account)/?.*$ /contact/ [R=301,L,NE]
RewriteRule ^(category|tag|author|20[0-9][0-9])/.*$ / [R=301,L,NE]
RewriteRule ^עוגת-קפה-נוגט/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A2%D7%95%D7%92%D7%AA-%D7%A7%D7%A4%D7%94-%D7%A0%D7%95%D7%92%D7%98/ [R=301,L,NE]
RewriteRule ^מוס-שוקולד/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A2%D7%95%D7%92%D7%AA-%D7%90%D7%95%D7%9B%D7%9E%D7%A0%D7%99%D7%95%D7%AA-%D7%95%D7%A4%D7%99%D7%A8%D7%95%D7%A8%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^elementor-942/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A2%D7%95%D7%92%D7%AA-%D7%90%D7%95%D7%9B%D7%9E%D7%A0%D7%99%D7%95%D7%AA-%D7%95%D7%A4%D7%99%D7%A8%D7%95%D7%A8%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^עוגת-גבינה/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A2%D7%95%D7%92%D7%99%D7%95%D7%AA-%D7%A9%D7%A7%D7%93%D7%99%D7%9D/ [R=301,L,NE]
RewriteRule ^עוגיות-שוקולדציפס-נוגט/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A2%D7%95%D7%92%D7%99%D7%95%D7%AA-%D7%A9%D7%95%D7%A7%D7%95%D7%9C%D7%93-%D7%A6%D7%99%D7%A4%D7%A1-%D7%A0%D7%95%D7%92%D7%98/ [R=301,L,NE]
RewriteRule ^סורבה-מנגו-אננס-בקישוט-פסיפלורה/?$ /%D7%9E%D7%AA%D7%9B%D7%95%D7%A0%D7%99%D7%9D/%D7%A1%D7%95%D7%A8%D7%91%D7%94-%D7%9E%D7%A0%D7%92%D7%95-%D7%90%D7%A0%D7%A0%D7%A1/ [R=301,L,NE]
RewriteRule ^product/מיזרה-צבעוני-200-גרם/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/שמבלות/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/קליק-מטאלי/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/סוכר-נצנצ-לקישוט/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/פניני-קראנצ-חלבי/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/גליליות-מיני/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/קרם-פסק-זמן/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/קרם-נוגט/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/קרם-וניל/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/קרם-קינדר-פרווה/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/מארז-קישוטים-לילדים/?$ /shop/ [R=301,L,NE]
RewriteRule ^product/נשיקות-ממותגות/?$ /shop/ [R=301,L,NE]
# וורדפרס: כל מה שאינו קובץ או תיקייה קיימים (המתכונים, ממשק הניהול)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
